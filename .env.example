# Design Inspiration - configuration
#
# Copy this to `.env` and fill it in. `.env` is git-ignored: never commit it.
#
# With NONE of this set, the library runs exactly as it always has - images in
# a folder on your PC, no account, no internet. You only need these to publish.

# ---------------------------------------------------------------- Supabase
#
# Dashboard -> Project Settings -> Data API (URL) and API Keys.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Safe to send to the browser: row-level security is what protects your data.
SUPABASE_ANON_KEY=

# SECRET. Bypasses row-level security entirely. Server-side only - never put
# this in the page, a client bundle, or a public repo. Rotate it if it leaks.
SUPABASE_SERVICE_ROLE_KEY=

# Created by supabase/schema.sql. Change only if you renamed the bucket.
SUPABASE_BUCKET=inspiration

# ------------------------------------------------------------------- server

PORT=4300
